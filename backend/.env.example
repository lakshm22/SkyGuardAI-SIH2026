# Shared Render PostgreSQL database
DATABASE_URL=postgresql://[YOURINFO].supabase.co:5432/postgres
DB_SCHEMA=skyguard

# Local fallback when DATABASE_URL is not set
SKYGUARD_DB=sqlite:///./data/skyguard.db

SKYGUARD_ADMIN_USERNAME=admin
SKYGUARD_ADMIN_PASSWORD=[YOURPASSWORD]
MODEL_PATH=./models/isolation_forest.joblib
CORS_ORIGINS=http://localhost:5173
ANOMALY_THRESHOLD=0.60
